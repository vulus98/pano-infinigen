# Multi-view panorama capture for Gaussian-Splatting training (INDOOR).
#
# Same idea as configs_nature/multiview.gin: one camera rig per scene whose
# sub-cameras form a small constellation, each rendered as a 360 deg
# equirectangular panorama with its pose saved. Indoor rooms are small, so the
# baseline is much smaller than outdoors -- but 15 cm is too little to give the
# GS head any parallax, so we use ~0.5 m.
#
# Load AFTER the indoor base configs, e.g.
#   --configs singleroom.gin fast_solve.gin multiview.gin
#
# IMPORTANT: keep multiview_rig_config.n_views == iterate_scene_tasks.n_subcams
# (data_schema/multiview.gin); the launcher keeps both in sync from $N_VIEWS.

camera.spawn_camera_rigs.n_camera_rigs = 1
camera.spawn_camera_rigs.camera_rig_config = @camera.multiview_rig_config()

camera.multiview_rig_config.n_views = 6
# Baseline drawn uniformly PER SCENE for baseline diversity. Rooms are small and
# densely furnished, and EVERY sub-camera of the ring must clear the furniture, so
# too wide a ring finds no valid anchor. This is bigger than the original ~0.18 m
# mean (that gave too little parallax); a wider ring may reduce valid rigs in tight
# rooms, so watch placement yield. Use a plain float to fix a single value.
camera.multiview_rig_config.baseline = ("uniform", 0.25, 0.5)  # metres (indoor)
camera.multiview_rig_config.pattern = "ring"     # "ring" | "sphere"
camera.multiview_rig_config.z_amplitude = 0.05   # +/- vertical parallax for the ring
camera.multiview_rig_config.converge_dist = 3.0  # m: neighbours toe-in (~5-8 deg)
                                                 # toward a point ~3 m ahead (room scale)
camera.multiview_rig_config.level_pitch_deg = 90 # must match camera_pose_proposal.pitch

# Level, horizon-facing panoramas.
camera.camera_pose_proposal.pitch = 90
camera.camera_pose_proposal.roll = 0

# The indoor base requires every camera to be >= 0.7 m from any surface. That is
# fine for a single camera but nearly impossible for a 4-8 camera ring in a small
# densely-furnished room: some sub-camera is almost always closer than 0.7 m, so
# placement finds ZERO candidates and the job spins forever. Relax it -- 0.2 m
# still keeps cameras out of (not inside) furniture, and close surfaces give a
# panorama MORE parallax, which is exactly what the GS head wants.
keep_cam_pose_proposal.min_terrain_distance = 0.15

# compute_base_views' upward sky-ray check ("inside_building") is for OUTDOOR
# cameras stuck under a building; indoors the ceiling is always overhead, so it
# rejects every valid pose. Turn it off for indoor.
compute_base_views.sky_visibility_check = False

# One valid anchor per scene is enough; don't over-search when validating N
# sub-cameras per candidate.
compute_base_views.min_candidates_ratio = 1

# With a wider baseline some rig can't fit all its sub-cameras in a small furnished
# room. Rather than fail the whole scene, keep the rigs that placed and drop the
# rest (compute_base_views already resamples up to max_tries before giving up).
configure_cameras.allow_fewer_rigs = True
